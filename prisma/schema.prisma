generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum ProspectStatus {
  NEW
  QUALIFIED
  MESSAGED
  REPLIED
  CALL_BOOKED
  NOT_A_FIT
  PARKED
}

enum InteractionType {
  NOTE
  MESSAGE_SENT
  REPLY_RECEIVED
  CALL
  MEETING
  OTHER
}

enum InteractionChannel {
  LINKEDIN
  EMAIL
  PHONE
  OTHER
}

model User {
  id        String     @id @default(cuid())
  email     String     @unique
  name      String?
  createdAt DateTime   @default(now())
  prospects Prospect[]
}

model Prospect {
  id                  String            @id @default(cuid())
  userId              String
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  source              String            @default("LinkedIn")
  profileUrl          String
  firstName           String?
  lastName            String?
  company             String?
  title               String?
  region              String?
  status              ProspectStatus    @default(NEW)
  lastContactedAt     DateTime?
  nextFollowUpAt      DateTime?
  tags                Json?
  rawAboutText        String
  rawExperienceText   String
  myNotes             String?
  aiCareerSummary     Json?
  aiLikelyPriorities  Json?
  aiFitScore          Int?
  aiFitReason         String?
  aiBestAngle         String?
  aiPersonalNote      String?
  aiFollowUpQuestion  String?
  aiModel             String?
  aiRunAt             DateTime?
  user                User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  interactions        Interaction[]

  @@unique([userId, profileUrl])
  @@index([updatedAt])
  @@index([status])
}

model Interaction {
  id         String             @id @default(cuid())
  prospectId String
  createdAt  DateTime           @default(now())
  type       InteractionType
  channel    InteractionChannel
  content    String
  outcome    String?
  prospect   Prospect           @relation(fields: [prospectId], references: [id], onDelete: Cascade)

  @@index([prospectId, createdAt])
}
